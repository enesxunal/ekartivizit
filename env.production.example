# E-Kartvizit / Vercel Environment Variables
NEXT_PUBLIC_SITE_URL=https://ekartvizit.tr

# Canva
NEXT_PUBLIC_CANVA_APP_ID=__SET_IN_VERCEL__
CANVA_CLIENT_SECRET=__SET_IN_VERCEL__
NEXT_PUBLIC_CANVA_REDIRECT_URI=https://ekartvizit.tr/api/canva/callback

# Tosla - server-side only
TOSLA_API_USER=__SET_IN_VERCEL__
TOSLA_API_PASS=__SET_IN_VERCEL__
TOSLA_CLIENT_ID=__SET_IN_VERCEL__
TOSLA_BASE_URL=https://entegrasyon.tosla.com/api/Payment/
TOSLA_DEBUG=0

# SMTP - server-side only
SMTP_HOST=__SET_IN_VERCEL__
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=__SET_IN_VERCEL__
SMTP_PASS=__SET_IN_VERCEL__

# Interim admin auth - DB auth gelene kadar
ADMIN_USERNAME=__SET_IN_VERCEL__
ADMIN_PASSWORD=__SET_IN_VERCEL__
ADMIN_SESSION_SECRET=__GENERATE_LONG_RANDOM_SECRET__

# Database - Faz 2
DATABASE_URL=__SET_IN_VERCEL__

# Analytics / public settings
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=905xxxxxxxxx
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_PERFORMANCE_MONITORING=true
